{
  "description": "chronista-style hooks: SessionStart (project context + creo-memories search) and Stop (fabrication tripwire — block reporting tool results with no matching tool_result this turn)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/fabrication-tripwire.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
